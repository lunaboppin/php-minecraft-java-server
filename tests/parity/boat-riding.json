{
  "name": "boat-riding",
  "normalizations": [
    "Compare a player getting into a boat on water and out by sneaking, and onto and off a raft on land.",
    "Entity IDs and UUIDs are left out; the rider's position shows where it sits and gets off.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "fill -8 55 -8 24 59 20 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -8 60 -8 24 70 20 minecraft:air"
    },
    {
      "action": "command",
      "text": "fill -1 60 -1 13 60 13 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill 0 60 0 12 60 12 minecraft:water"
    },
    {
      "action": "command",
      "text": "tp @s 6.5 61 -0.5 0 30"
    },
    {
      "action": "command",
      "text": "gamemode survival"
    },
    {
      "action": "command",
      "text": "summon oak_boat 6.5 60.5 2.5"
    },
    {
      "action": "command",
      "text": "summon bamboo_raft 14.5 60 2.5 {Rotation:[90f,0f]}"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "boats",
      "fields": [
        "entity_packets"
      ]
    },
    {
      "action": "interact",
      "entity": "oak_boat",
      "index": 0
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "snapshot",
      "name": "in_the_boat",
      "fields": [
        "position",
        "entity_packets"
      ]
    },
    {
      "action": "packet",
      "name": "player_input",
      "hex": "20"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "packet",
      "name": "player_input",
      "hex": "00"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "snapshot",
      "name": "out_of_the_boat",
      "fields": [
        "position",
        "entity_packets"
      ]
    },
    {
      "action": "command",
      "text": "tp @s 14.5 60 0.5 0 0"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "interact",
      "entity": "bamboo_raft",
      "index": 0
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "snapshot",
      "name": "on_the_raft",
      "fields": [
        "position"
      ]
    },
    {
      "action": "packet",
      "name": "player_input",
      "hex": "20"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "packet",
      "name": "player_input",
      "hex": "00"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "snapshot",
      "name": "off_the_raft_on_land",
      "fields": [
        "position"
      ]
    }
  ]
}

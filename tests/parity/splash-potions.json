{
  "name": "splash-potions",
  "normalizations": [
    "Throw splash potions straight down from survival: healing after 8 damage, then harming, each landing at the thrower's feet with its full effect, and each used up.",
    "A water splash potion puts out fire beside the block it lands on.",
    "Use matching flat terrain with natural spawning, regeneration and fire spread off."
  ],
  "steps": [

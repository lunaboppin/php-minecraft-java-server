      "action": "command",
      "text": "fill -4 63 -4 10 63 8 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 64 -4 10 70 8 minecraft:air"
    },
    {
      "action": "command",
      "text": "kill @e[type=!player]"
    },
    {
      "action": "command",
      "text": "summon sheep 0.5 64 1.5 {NoAI:1b,Color:14b}"
    },
    {

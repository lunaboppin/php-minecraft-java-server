{
  "name": "dispenser-projectiles",
  "normalizations": [
    "Compare a dispenser shooting an arrow straight up, which comes back down and stays, and one throwing a snowball, which breaks on the ground, with what each dispenser has left.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "gamerule spawn_mobs false"
    },
    {
      "action": "command",
      "text": "gamemode survival @s"
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",
      "text": "fill -2 63 -2 16 63 8 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -2 64 -2 16 72 8 minecraft:air"
    },
    {
      "action": "command",
      "text": "kill @e[type=!player]"
    },
    {
      "action": "command",
      "text": "setblock 0 64 0 minecraft:dispenser[facing=up]"
    },
    {
      "action": "command",
      "text": "item replace block 0 64 0 container.0 with minecraft:arrow 1"
    },
    {
      "action": "command",
      "text": "setblock 6 64 0 minecraft:dispenser[facing=east]"
    },
    {
      "action": "command",
      "text": "item replace block 6 64 0 container.4 with minecraft:snowball 2"
    },
    {
      "action": "command",
      "text": "setblock 1 64 0 minecraft:redstone_block"
    },
    {
      "action": "command",
      "text": "setblock 6 64 1 minecraft:redstone_block"
    },
    {
      "action": "wait",
      "seconds": 5
    },
    {
      "action": "snapshot",
      "name": "shot",
      "fields": [
        "entities"
      ]
    },
    {
      "action": "command",
      "text": "tp @s 0.5 64 -1.5 0 30"
    },
    {
      "action": "place",
      "position": [
        0,
        64,
        0
      ],
      "face": 2,
      "cursor": [
        0.5,
        0.5,
        0
      ]
    },
    {
      "action": "snapshot",
      "name": "arrow-dispenser",
      "fields": [
        "inventory"
      ]
    },
    {
      "action": "packet",
      "name": "container_close",
      "hex": "01"
    },
    {
      "action": "command",
      "text": "tp @s 6.5 64 -1.5 0 30"
    },
    {
      "action": "place",
      "position": [
        6,
        64,
        0
      ],
      "face": 2,
      "cursor": [
        0.5,
        0.5,
        0
      ]
    },
    {
      "action": "snapshot",
      "name": "snowball-dispenser",
      "fields": [
        "inventory"
      ]
    },
    {
      "action": "packet",
      "name": "container_close",
      "hex": "02"
    }
  ]

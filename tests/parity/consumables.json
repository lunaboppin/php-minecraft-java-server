    },
    {
      "action": "packet",
      "name": "use_item",
      "hex": "00020000000000000000"
    },
    {
      "action": "wait",
      "seconds": 2.5
    },
    {
      "action": "snapshot",
      "name": "harming",
      "fields": [
        "inventory",
        "health"
      ]
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",

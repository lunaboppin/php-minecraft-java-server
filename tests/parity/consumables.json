  "steps": [
    {
      "action": "command",
      "text": "gamerule spawn_mobs false"
    },
    {
      "action": "command",
      "text": "gamerule natural_health_regeneration false"
    },
    {
      "action": "command",
      "text": "gamemode survival @s"
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",
      "text": "fill -3 63 -3 3 63 3 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -3 64 -3 3 66 3 minecraft:air"
    },
    {
      "action": "command",
      "text": "tp @s 0.5 64 0.5 0 0"
    },
    {
      "action": "wait",
      "seconds": 0.5
    },
    {
      "action": "command",
      "text": "damage @s 6 minecraft:generic"
    },
    {
      "action": "command",
      "text": "give @s potion[potion_contents={potion:\"minecraft:healing\"}]"

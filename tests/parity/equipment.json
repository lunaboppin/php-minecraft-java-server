{
  "name": "multiplayer-equipment",
  "observer": true,
  "normalizations": [
    "Compare six player equipment slots observed by a second connected client after simulation barriers.",
    "Treat omitted slots as empty; normalize the vanilla main/offhand swap event to the same slot state. Ignore entity IDs and packet grouping/order."

      "action": "command",
      "text": "gamerule spawn_mobs false"
    },
    {
      "action": "command",
      "text": "gamemode survival @s"
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",
      "text": "fill -3 64 -3 3 66 3 minecraft:air"
    },
    {
      "action": "command",
      "text": "setblock 0 64 0 minecraft:smithing_table"
    },
    {
      "action": "command",
      "text": "tp @s 0.5 64 -2.5 0 30"
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",
      "text": "give @s netherite_upgrade_smithing_template 2"
    },
    {
      "action": "command",

{
  "name": "contact-damage",
  "normalizations": [
    "Compare a still player beside a cactus (unhurt), on magma and on a lit campfire (each until death, with natural regeneration off) and on an unlit campfire (unhurt).",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "gamerule natural_health_regeneration false"
    },
    {
      "action": "command",
      "text": "gamerule show_death_messages false"
    },
    {
      "action": "command",
      "text": "gamemode survival @s"
    },
    {
      "action": "command",
      "text": "clear @s"
    },
    {
      "action": "command",
      "text": "fill -4 63 -4 8 63 8 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 64 -4 8 70 8 minecraft:air"
    },
    {
      "action": "command",
      "text": "setblock 0 64 0 minecraft:cactus"
    },
    {
      "action": "command",
      "text": "tp @s -0.25 64 0.5"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "still-by-cactus",
      "fields": [
        "health",
        "deaths"
      ]
    },
    {
      "action": "command",
      "text": "setblock 4 63 0 minecraft:magma_block"
    },
    {
      "action": "command",
      "text": "tp @s 4.5 64 0.5"
    },
    {
      "action": "wait",
      "seconds": 20
    },
    {
      "action": "snapshot",
      "name": "magma",
      "fields": [
        "deaths"
      ]
    },
    {
      "action": "respawn"
    },
    {
      "action": "command",
      "text": "setblock 6 64 4 minecraft:campfire"
    },
    {
      "action": "command",
      "text": "tp @s 6.5 64.4375 4.5"
    },
    {
      "action": "wait",
      "seconds": 20
    },
    {
      "action": "snapshot",
      "name": "campfire",
      "fields": [
        "deaths"
      ]
    },
    {
      "action": "respawn"
    },
    {
      "action": "command",
      "text": "setblock 2 64 4 minecraft:campfire[lit=false]"
    },
    {
      "action": "command",
      "text": "tp @s 2.5 64.4375 4.5"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "unlit-campfire",
      "fields": [
        "health",
        "deaths"
      ]
    }
  ]
}

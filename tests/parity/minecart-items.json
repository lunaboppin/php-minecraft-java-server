{
  "name": "minecart-items",
  "normalizations": [
    "Compare a minecart item set on a straight rail, on a slope and refused by stone, a minecart hit once by a fist, one removed by a creative player's hit and one broken by a sword, its dropped minecart picked up.",
    "Entity IDs and UUIDs are left out; motion is compared as sent. The dropped minecart's random motion is not compared, only the inventory after its pickup.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "gamerule spawn_mobs false"
    },
    {
      "action": "command",
      "text": "fill -4 59 -6 12 60 6 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 61 -6 12 70 6 minecraft:air"
    },
    {
      "action": "command",
      "text": "setblock 0 61 0 minecraft:rail"
    },
    {
      "action": "command",
      "text": "setblock 4 61 -1 minecraft:stone"
    },
    {
      "action": "command",
      "text": "setblock 4 61 0 minecraft:rail[shape=ascending_north]"
    },
    {
      "action": "command",
      "text": "tp @s 2.5 61 -2.5 0 30"
    },
    {
      "action": "command",
      "text": "gamemode survival"
    },
    {
      "action": "command",

      "action": "command",
      "text": "fill -4 62 -6 24 63 10 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 64 -6 24 80 10 minecraft:air"
    },
    {
      "action": "command",
      "text": "setblock 0 64 0 minecraft:daylight_detector"
    },
    {
      "action": "command",
      "text": "setblock 3 64 0 minecraft:daylight_detector[inverted=true]"
    },

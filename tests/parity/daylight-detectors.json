{
  "name": "daylight-detectors",
  "normalizations": [
    "Compare daylight detectors' power, under open sky, under a stone roof and inverted, at fixed times of day.",
    "Detectors update every 20 game ticks; time does not advance.",
    "Use matching flat terrain."
  ],
  "steps": [

{
  "name": "minecart-pushing",
  "normalizations": [
    "Compare a minecart pushed by a player standing in it, a slow minecart stopped by a cow, a rolling minecart taking on a cow, and a rolling minecart running into a still one.",
    "Entity IDs and UUIDs are left out; motion is compared as sent.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "fill -4 59 -8 40 60 12 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 61 -8 40 70 12 minecraft:air"
    },
    {
      "action": "command",
      "text": "tp @s 10.5 61 -6.5 0 0"
    },
    {
      "action": "command",
      "text": "fill 0 61 0 30 61 0 minecraft:rail"
    },
    {
      "action": "command",
      "text": "fill 0 61 4 30 61 4 minecraft:rail"
    },
    {
      "action": "command",
      "text": "fill 0 61 8 30 61 8 minecraft:rail"
    },
    {
      "action": "command",
      "text": "summon minecart 3.5 61 0.5"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "snapshot",
      "name": "cart",
      "fields": [
        "entity_packets"
      ]
    },
    {
      "action": "command",
      "text": "tp @s 3.1 61 0.5 -90 0"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "pushed_by_player",
      "fields": [
        "entity_packets"
      ]
    },
    {
      "action": "command",
      "text": "tp @s 10.5 61 -6.5 0 0"
    },
    {
      "action": "command",
      "text": "summon cow 12.5 61 4.5 {NoAI:1b,Silent:1b}"
    },
    {
      "action": "command",
      "text": "summon minecart 3.5 61 4.5 {Motion:[0.4d,0.0d,0.0d]}"
    },
    {
      "action": "wait",
      "seconds": 4
    },
    {
      "action": "snapshot",
      "name": "slow_cart_stopped_by_cow",
      "fields": [
        "entity_packets"
      ]
    },
    {
      "action": "command",
      "text": "summon minecart 14.5 61 8.5"
    },
    {
      "action": "command",
      "text": "summon minecart 3.5 61 8.5 {Motion:[0.4d,0.0d,0.0d]}"
    },
    {
      "action": "wait",
      "seconds": 4
    },
    {
      "action": "snapshot",
      "name": "carts_collide",
      "fields": [
        "entity_packets"
      ]
    },
    {
      "action": "command",
      "text": "fill 0 61 11 30 61 11 minecraft:rail"
    },
    {
      "action": "command",
      "text": "summon cow 7.5 61 11.5 {NoAI:1b,Silent:1b}"
    },
    {
      "action": "command",
      "text": "summon minecart 3.5 61 11.5 {Motion:[0.4d,0.0d,0.0d]}"
    },
    {
      "action": "wait",
      "seconds": 4
    },
    {
      "action": "snapshot",
      "name": "cow_picked_up",
      "fields": [
        "entity_packets"
      ]
    }
  ]
}

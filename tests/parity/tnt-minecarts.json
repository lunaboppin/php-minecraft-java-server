{
  "name": "tnt-minecarts",
  "normalizations": [
    "Compare a TNT minecart primed by a powered activator rail and its explosion, which leaves the rails and the blocks under them, and minecarts caught by a TNT explosion.",
    "Entity IDs and UUIDs are left out, and blocks drop nothing, as their scatter is random; only blocks every ray is certain to destroy or spare are compared.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "gamerule block_drops false"
    },
    {
      "action": "command",
      "text": "gamerule tnt_explosion_drop_decay false"
    },
    {
      "action": "command",
      "text": "fill -8 55 -8 24 60 8 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -8 61 -8 24 70 8 minecraft:air"
    },
    {
      "action": "command",
      "text": "tp @s 7.5 61 -7.5 0 0"
    },
    {
      "action": "command",
      "text": "fill 0 61 0 14 61 0 minecraft:rail"
    },
    {
      "action": "command",
      "text": "setblock 7 61 0 minecraft:activator_rail[powered=true,shape=east_west]"
    },
    {
      "action": "command",
      "text": "setblock 7 60 0 minecraft:redstone_block"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "command",
      "text": "summon tnt_minecart 7.5 61 0.5"
    },
    {
      "action": "wait",

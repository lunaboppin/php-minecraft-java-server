{
  "name": "minecart-restart",
  "normalizations": [
    "Compare minecarts after a restart saved them: two minecarts rolled to rest against blocks at the ends of their rails, one heading each way.",
    "Covers saving a minecart's position, motion, rotation and FlippedRotation with the level.",
    "Entity IDs and UUIDs are left out.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "fill -4 59 -4 12 60 4 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -4 61 -4 12 64 4 minecraft:air"
    },
    {
      "action": "command",
      "text": "fill 0 61 0 6 61 0 minecraft:rail"
    },
    {
      "action": "command",
      "text": "setblock 7 61 0 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill 0 61 2 6 61 2 minecraft:rail"
    },
    {
      "action": "command",
      "text": "setblock -1 61 2 minecraft:stone"
    },
    {
      "action": "command",
      "text": "summon minecraft:minecart 0.5 61.0625 0.5 {Motion:[0.4d,0.0d,0.0d]}"
    },
    {
      "action": "command",
      "text": "summon minecraft:minecart 6.5 61.0625 2.5 {Motion:[-0.4d,0.0d,0.0d]}"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "restart"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "snapshot",
      "name": "after",
      "fields": [
        "entity_packets"
      ]
    }
  ]
}
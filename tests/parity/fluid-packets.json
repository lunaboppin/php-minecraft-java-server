{
  "name": "fluid-packets",
  "normalizations": [
    "Compare the block_update and section_blocks_update packets, in order, as water spreads over flat ground and falls off a platform, lava spreads and meets water, and water drains after its source is removed.",
    "The packets sent while setting up are cleared by the first snapshot.",
    "Use matching flat terrain."
  ],
  "steps": [
    {
      "action": "command",
      "text": "weather clear"
    },
    {
      "action": "command",
      "text": "fill -12 59 -12 12 60 12 minecraft:stone"
    },
    {
      "action": "command",
      "text": "fill -12 61 -12 12 70 12 minecraft:air"
    },
    {
      "action": "command",
      "text": "tp @s 0.5 61 -10.5 0 30"
    },
    {
      "action": "command",
      "text": "fill 4 61 4 8 63 8 minecraft:stone"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "snapshot",
      "name": "setup",
      "fields": [
        "block_packets"
      ]
    },
    {
      "action": "command",
      "text": "setblock -4 61 0 minecraft:water"
    },
    {
      "action": "command",
      "text": "setblock 6 64 6 minecraft:water"
    },
    {
      "action": "command",
      "text": "setblock 4 61 -6 minecraft:lava"
    },
    {
      "action": "command",
      "text": "setblock 7 61 -6 minecraft:water"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "flowing",
      "fields": [
        "block_packets"
      ]
    },
    {
      "action": "command",
      "text": "setblock -4 61 0 minecraft:air"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "snapshot",
      "name": "draining",
      "fields": [
        "block_packets"
      ]
    }
  ]
}
